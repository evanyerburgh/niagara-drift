expect view 14
release FX
expect view 0
tap HOME
expect view 1
tap FX
tap HOME
expect view 0
tap FX
tap FX
expect view 15
tap HOME
# SELECT: the LFO rate; PRESETS: nothing yet (the macro to come), the waves stay
spin SELECT 10
expect par47 40
spin PRESET 2
expect par48 1
expect par49 1
# MIDI: a note on channel 2 tunes drone II to it exactly
midi 91 3C 64
wait 20
expect par21 6000
# SAVE while playing: the output dips out (20 ms), the write, back (30 ms)
tap SAVE
wait 150
expect store_writes 1
expect dirty 0
# no autosave while the drone plays (a knob moved and back: unsaved again)
spin K1 1
spin K1 -1
expect dirty 1
wait 5000
expect dirty 1
expect store_writes 1
# PLAY again: out over the fade (Fade is 52 now: 2.0 s), then the autosave
tap PLAY
expect playing 0
wait 2500
expect fade 0
wait 4500
expect dirty 0
# the knob came back where it was: the flash has this sound already, so nothing is written
expect store_writes 1
wavstop
# everything comes back after a reboot
reboot
wait 300
expect par0 4977
expect par21 6000
expect par42 1
expect par44 1
expect par6 2
expect playing 0
# stopped, the screen still shows where the pitches are set (MIDI put drone II on C4)
expect pitch1 6000
# scenes: SAVE held + white key 1 stores (into the flash at once); the key lights
press SAVE
tapkey w0
release SAVE
expect scenes 1
expect store_writes 2
expect view 0
# the sound is scene 1 (its key blinks), until a knob is turned
expect scene_at 0
spin K1 10
expect scene_at -1
expect par0 5577
spin K2 20
expect par7 850
# a scene doesn't carry the room's settings: the stereo width set after storing stays when it's recalled
tap GLO
tap GLO
expect view 11
spin K2 30
expect par53 90
tap HOME
expect view 0
# white key 1: back to the scene, morphing over the Scene switch time (1.1 s)
tapkey w0
wait 450
expect par7 >670
expect par7 <830
expect par0 >5000
expect par0 <5550
wait 900
expect par7 650
expect par53 90
expect par0 4977
expect scene_at 0
# an empty slot: nothing changes
tapkey w1
expect scenes 1
expect par7 650
# a knob turned during a morph stops it where it is
spin K2 20
tapkey w0
wait 300
spin K4 1
wait 1500
expect par7 >670
wait 100
shot scenes.png
# the scene survives a reboot (the SAVE above wrote it)
reboot
wait 300
expect scenes 1
