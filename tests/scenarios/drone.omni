# from the starting sound before 2026-10-17 (these checks were made on it)
classic
# scenes switch in 1.1 s here (the Scene time at 30; 46, ~4 s, on a new FM-1 since 2026-10-19)
set 71 30
# Pitch lock starts on (Evan, 2026-10-19: a turned pitch knob says where its key is); off for what follows
expect par74 1
tapkey b3
expect par74 0
# Niagara Drift, the control map: two drones. KNOB 1-2 drone I, KNOB 3-4 drone II on every page; page
# buttons (tap to stay, hold to peek); OCT- / OCT+; the black keys as switches, following the page; pitch
# link; the LFO on SELECT / ALGORITHM / PRESETS; MIDI; scenes on the white keys; save and reboot.
# Parameters (drone.h, 21 a drone): drone I 0..20 (pitch 0, X-Wave 1, width 2, mix 5, sub oct 6, cutoff 7,
# reso 8, mode 9, level 11, partner 12, osc tap 13, osc depth 14, osc LFO to 15, filter tap 16, filter
# depth 17, filter LFO to 18, noise 19, colour 20), drone II the same +21; then 42 cross-mod, 43 its amount,
# 44 hard sync, 45 pitch link, 46 link offset, 47 LFO rate, 48 Wave I, 49 Wave II, 50 Glide, 51 Fade, 55 Pulse,
# 56 its rate, 60 delay time, 61 repeats, 62 delay mix, 63 reverb mix, 64 reverb type, 65 delay LFO tap, 66 its
# depth.
# Pages: 0 Play 1 1 Play 2 2 Tone 1 3 Life 4 Osc 5 Sub · Drive 6 LFO depths 7 Mods 8 Partner 9 Pitch moves
# 10 Setup 1 11 Setup 2 12 Swell 13 Delay 14 Reverb 15 Types.
# a new FM-1 plays the Presets; these scenes go in bank A (SEL + D5)
expect bank 3
press SEL
tapkey w12
release SEL
expect bank 0
wav drone.wav
wait 300
shot stopped.png
expect view 0
expect playing 0
expect par0 5000
expect par21 5700
expect scenes 0
# PLAY: in over the default fade (1 s)
tap PLAY
wait 1600
expect fade 100
expect level0 >3
expect level1 >3
peakreset
wait 500
# under full scale (the output's soft knee starts at -3 dB; the reverb's peaks reach into it)
expect peak_db_max -0.1
expect peak_db_min -20
shot playing.png
# the Play page: KNOB 1 drone I's pitch (60 cents a detent; SEL held, a cent), KNOB 2 its cutoff,
# KNOB 3-4 drone II's
spin K1 2
expect par0 5120
press SEL
spin K1 -83
release SEL
expect par0 5037
expect view 0
spin K2 -5
expect par7 650
spin K3 1
expect par21 5760
spin K4 10
expect par28 780
wait 600
expect pitch0 5037
# a slow turn (clicks 500 ms apart) glides on between clicks, not in stairs: each click glides over the
# time since the one before, so 300 ms after the last it's still on its way (a 250 ms limit had it there)
turn K1 2 500
turn K1 1 10
wait 300
expect pitch0 >5160
expect pitch0 <5212
wait 300
expect pitch0 5217
spin K1 -3
expect par0 5037
wait 100
# HOME again: Play 2, each drone's level and resonance (KNOB 1-2 drone I, 3-4 drone II)
tap HOME
expect view 1
spin K3 -20
expect par32 41
spin K4 10
expect par29 450
spin K4 -10
expect par29 350
# a slow turn is a step a detent
set 11 0
wait 500
turn K1 5 300
expect par11 5
wait 500
set 11 75
wait 100
shot play2.png
tap HOME
expect view 0
# OCT- / OCT+: the LFO's waves (v0.2): a tap is the next shape, round and round; SEL + OCT the one before
expect par48 1
expect par49 1
tap OCT-
expect par48 2
tap OCT+
expect par49 2
press SEL
tap OCT-
tap OCT-
release SEL
expect par48 0
tap OCT-
expect par48 1
press SEL
tap OCT+
release SEL
expect par49 1
# ...back past Off: round and round
press SEL
tap OCT+
tap OCT+
release SEL
expect par49 10
tap OCT+
tap OCT+
expect par49 1
# ALGORITHM: the Movement (every LFO depth together, 50 = as set, 100 = twice)
expect par75 50
spin ALGO 5
expect par75 55
spin ALGO -5
expect par75 50
# hold ENV to peek: the knobs are the Tone page's (noise, colour) while it's held, then back to Play
press ENV
expect view 2
spin K1 20
expect par19 20
release ENV
expect view 0
# a long hold without turning is a peek too
press EDIT
wait 600
release EDIT
expect view 0
# tap ENV: Tone, one page: KNOB 1-2 drone I's Noise and Colour (0 white .. 100 pink, pink to start), 3-4 drone II's
tap ENV
expect view 2
expect par20 100
spin K1 5
expect par19 25
spin K2 -40
expect par20 60
spin K2 50
expect par20 100
spin K4 -100
expect par41 0
spin K3 100
expect par40 100
spin K1 -25
spin K3 -100
expect par19 0
expect par40 0
# ENV again: Life: Character, Feedback (KNOB 3-4 nothing)
tap ENV
expect view 3
spin K1 10
expect par77 10
spin K1 -10
expect par77 0
spin K4 -10
expect par97 50
tap ENV
expect view 2
# EDIT: Osc (X-Wave, PW); again: Sub · Drive (osc mix, drive); again: Osc
tap EDIT
expect view 4
spin K1 -67
expect par1 0
spin K2 10
expect par2 40
tap EDIT
expect view 5
spin K1 10
expect par5 40
spin K2 20
expect par10 40
tap EDIT
expect view 4
# LFO: the depths, and the keys switch to LFO routing
tap LFO
expect view 6
spin K2 30
expect par17 55
tapkey b0
expect par13 2
# the route keys go round: Wave II, both (I+II), Wave I
tapkey b0
expect par13 3
tapkey b0
expect par13 1
tapkey b0
expect par13 2
# the filter LFO onto the resonance and back (the third key)
tapkey b2
expect par18 1
tapkey b2
expect par18 0
tapkey b1
expect par15 1
tapkey b8
expect par37 3
wait 100
shot lfo.png
# LFO reset (drone I's filter group, either layer): the LFO back to the start of its cycle (a triangle
# starts at the bottom)
tapkey b4
wait 1000
expect lfo0 >-40
tapkey b4
wait 30
expect lfo0 <-80
# held half a second, the reset key locks the LFO to the pulse's bars (the key stays lit); again: free
key b4 down
wait 700
key b4 up
expect par67 1
key b4 down
wait 700
key b4 up
expect par67 0
# LFO again: Mods, the rate mod (KNOB 1 its depth, KNOB 2 the wave that moves it); again: LFO
tap LFO
expect view 7
spin K1 50
expect par68 50
spin K2 1
expect par69 3
spin K1 -50
expect par68 0
# ... and cross-mod's amount (KNOB 3) and the delay LFO's depth (KNOB 4), moved here from Filter 2 and
# Effects 2
spin K3 10
expect par43 50
spin K4 20
expect par66 20
spin K4 -20
tap LFO
expect view 6
# the normal keys (back on Play): partner, sub -2, HP, hard sync, cross-mod
tap HOME
expect view 0
tapkey b0
expect par12 0
tapkey b1
expect par6 2
# the sub key goes round: -2 oct, 1/3, 1/5, -3 oct, -4 oct (v0.3), -1 oct (then -2 again, for what follows)
tapkey b1
expect par6 3
tapkey b1
expect par6 4
tapkey b1
expect par6 5
tapkey b1
expect par6 6
tapkey b1
expect par6 1
tapkey b1
expect par6 2
# PITCH LOCK (the global pair's first key, key 4): the pitch knobs do nothing until it's off again
tapkey b3
expect par74 1
spin K1 5
expect par0 5037
tapkey b3
expect par74 0
# with SEL held, a black key names itself on the map and doesn't switch (2026-10-19)
press SEL
tapkey b3
expect par74 0
tapkey b1
expect par6 2
release SEL
# the filter key (drone I's third) goes round: LP, BP, HP
tapkey b2
expect par9 1
tapkey b2
expect par9 2
tapkey b9
expect par44 1
tapkey b10
expect par42 1
wait 100
shot switches.png
# pitch link: drone II keeps its pitch (offset = 4560 - 3837 = 723), KNOB 3 moves the offset, drone I
# carries drone II (pitch link: the links pair's first key, key 9)
tapkey b8
expect par45 1
expect par46 723
spin K3 -1
expect par46 663
spin K1 -1
expect par0 4977
wait 400
expect pitch1 5640
tapkey b8
expect par45 0
expect par21 5640
# ARP, as the other page buttons (2026-10-25): a tap opens the Swell page and leaves the Swell alone; a tap on the
# page is the Swell on / off; held, a peek (its knobs turn, nothing switches)
tap ARP
expect view 12
expect par55 0
tap ARP
expect par55 1
expect view 12
tap HOME
expect view 0
press ARP
expect view 12
spin K1 10
expect par56 55
release ARP
expect view 0
expect par55 1
wait 400
shot pulse.png
tap ARP
expect view 12
expect par55 1
tap ARP
expect par55 0
tap HOME
expect view 0
# REC: the motion loop. Record two turns of KNOB 2 (drone I's cutoff, 50 now), 0.3 s apart, then loop:
# it starts from where the recording did, plays the turns on time, comes round again; REC stops it where
# it is
tap REC
expect loop 1
wait 200
spin K2 10
expect par7 750
wait 300
spin K2 10
expect par7 850
wait 300
tap REC
expect loop 2
expect par7 650
wait 300
expect par7 750
wait 300
expect par7 850
wait 300
expect par7 650
wait 200
expect par7 750
wait 100
shot loop.png
tap REC
expect loop 0
wait 600
expect par7 750
spin K2 -10
expect par7 650
