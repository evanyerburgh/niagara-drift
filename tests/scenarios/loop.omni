# from the starting sound before 2026-10-17 (these checks were made on it)
classic
# Pitch lock off (on at start since 2026-10-19): these move the pitch
set 74 0
# the motion loop and the gliding knobs (2026-10-10 review): the loop goes back to its start gliding
# over the Morph time (0.62 s), not in a jump; a recording runs past 30 s (up to 5 minutes)
# drone I's filter LFO and the Drift at 0 (the default breathes and wanders), so the cutoff probe sees the
# knob alone
tap LFO
spin K2 -25
expect par17 0
tap ENV
expect view 2
spin K4 -30
expect par52 0
tap HOME
expect view 0
tap PLAY
wait 1500
expect par0 5000
# the cutoff glides between a slow turn's detents (each over the time since the last): half way between
# two detents 300 ms apart, it's half way (not still on the first step, as the old 60 ms smoothing left it)
expect par7 700
turn K2 1 10
wait 300
turn K2 1 10
wait 150
expect cut0 >7120
expect cut0 <7185
spin K2 -2
expect par7 700
# SEL held: cutoff in tenths (a detent 1, not 10)
press SEL
spin K2 3
release SEL
expect par7 703
spin K2 -1
expect par7 693
spin K2 1
press SEL
spin K2 -3
release SEL
expect par7 700
tap REC
expect loop 1
wait 200
turn K1 10 200
wait 500
expect par0 >5500
# loop: back to the start (5000), gliding: 0.1 s in, still most of the way up
tap REC
expect loop 2
wait 100
expect pitch0 >5350
wait 150
expect pitch0 >5150
tap REC
expect loop 0
# a long recording: still recording at 40 s (a knob moved at 35 s, so it has something to loop)
tap REC
expect loop 1
wait 35000
spin K2 2
wait 5000
expect loop 1
tap REC
expect loop 2
tap REC
expect loop 0
# SEL + PLAY: drone II alone fades out (drone I plays on), and back in
press SEL
tap PLAY
release SEL
expect playing 1
wait 2500
expect level1 0
expect level0 >3
press SEL
tap PLAY
release SEL
wait 2500
expect level1 >3
# GESTURES IN THE LOOP (Evan, 2026-10-28: a loop of gestures said "nothing moved"): Weight (D5) held 2 s and let go,
# recorded as it went; looped, it rises and falls again each pass, from where the recording began (none)
expect gam0 0
tap REC
expect loop 1
wait 200
key w12 down
wait 2000
expect gam0 >30
key w12 up
wait 300
tap REC
expect loop 2
wait 1900
expect gsent0 >30
wait 1000
expect gsent0 <30
# stopped: the gesture stays where the loop had it, then goes its own way (out)
wait 1500
tap REC
expect loop 0
expect gam0 >20
wait 8000
expect gam0 0
# a second loop with the same gesture starts from where it is now, not where the last loop left it (the review: Weight
# swept down from full at the new loop's start)
tap REC
wait 500
key w12 down
wait 700
key w12 up
wait 300
tap REC
expect loop 2
wait 50
expect gsent0 <30
tap REC
expect loop 0
wait 8000
expect gam0 0
# A SCENE TAPPED IN THE LOOP: a scene with the cutoff up (bank A, key 1), the sound back down; recorded, the tap;
# looped, each pass starts on the sound the recording began on and goes to the scene again
press SEL
tapkey w12
release SEL
expect bank 0
set 71 0
spin K2 20
expect par7 900
press SAVE
tapkey w0
release SAVE
spin K2 -20
expect par7 700
wait 200
tap REC
wait 200
tapkey w0
wait 800
expect par7 900
tap REC
expect loop 2
wait 100
expect par7 700
wait 500
expect par7 900
wait 650
expect par7 700
tap REC
expect loop 0
# A SCENE BLENDED BY PRESSURE IN THE LOOP: key 1 pressed half way for 1.5 s and let go (the blend stays, part way);
# looped, each pass starts back on the sound the recording began on and blends part way again
wait 300
expect par7 700
tap REC
wait 200
pressure w0 70
key w0 down
wait 1500
key w0 up
pressure w0 0
wait 300
expect par7 >750
expect par7 <880
tap REC
expect loop 2
wait 100
expect par7 700
wait 1700
expect par7 >750
expect par7 <880
tap REC
expect loop 0
# a blend let go (not taken), then a knob recorded on a value the scene moves: looped, the knob's move holds (the review:
# the let-go blend went on being forced onto the sound, over the knob's move)
spin K2 -10
wait 300
tap REC
wait 200
pressure w0 70
key w0 down
wait 1500
key w0 up
pressure w0 0
wait 500
spin K2 -20
wait 1000
expect par7 <700
tap REC
expect loop 2
wait 2700
expect par7 <700
tap REC
expect loop 0
