# MIDI CLOCK IN (v0.3, step 3): the tempo and the jitter of a clock from a DAW, as the test build shows them.
# clkbpm is the tempo x 10, clkjit / clkmax the jitter (RMS / largest) in us
tap PLAY
wait 500
# a steady 120 BPM: two beats to settle, then on the tempo, no jitter
clock 120
wait 1500
expect clkbpm 1200
expect clkjit <20
# 90 BPM: there in two beats
clock 90
wait 1500
expect clkbpm 900
# a DAW's clock, each pulse up to 2 ms off: the tempo still 90, the jitter seen (+-2 ms even: about 1.2 RMS)
clock 90 2
wait 3000
expect clkbpm >895
expect clkbpm <905
expect clkjit >700
expect clkjit <1700
expect clkmax <2100
# Start, Continue, Stop counted (each clock command above sent a Start first: 3, and this one)
midi FA 0 0
midi FB 0 0
midi FC 0 0
wait 50
expect clkstarts 411
# the clock gone, then back at 140: lost, and a fresh tempo
clock 0
wait 1000
clock 140
wait 1500
expect clkbpm 1400
# THE SWELL ON THE CLOCK: a breath a quarter note (the Division, 100 = 7; the hardest), a clock 2 minutes long, each
# pulse up to 4 ms off: the Swell stays on the beat (swerr: its error in thousandths of a breath), it doesn't drift
set 55 1
set 100 7
clock 120 4
wait 5000
expect swerr <30
wait 55000
expect swerr <30
wait 60000
expect swerr <30
# the clock stops: the Swell carries on at the last tempo, and a Start (a new clock) puts it at the top
clock 0
wait 3000
expect clkbpm >1195
expect clkbpm <1205
clock 100
wait 3000
expect swerr <30
# on a clock, scenes leave the Swell's on / off and its division alone (Evan, 2026-10-26): P12 (Clean) has the Swell off
# and 8 bars; tapped, the Swell stays on at a quarter note
set 71 0
expect par55 1
expect par100 7
press SEL
tapkey w14
release SEL
tapkey w3
wait 1000
expect par55 1
expect par100 7
expect swerr <30
# THE LFO on the clock: SELECT turns its cycle (LFO div, 101; 7 = a quarter note), steered to the beat
expect par101 3
spin SELECT 4
expect par101 7
wait 4000
expect lfoerr <30
# THE DELAY: its time a note value (Dly note, 102): a quarter note at 100 BPM is 600 ms (dlyt: tenths of a ms)
tap FX
expect view 13
expect par102 5
wait 2000
expect dlyt >5950
expect dlyt <6050
# ... a half note: 1.2 s; a bar (2.4 s) is longer than the line: halved, 1.2 s
spin K2 3
expect par102 8
wait 2000
expect dlyt >11900
expect dlyt <12100
spin K2 2
expect par102 10
wait 2000
expect dlyt >11900
expect dlyt <12100
tap HOME
# SCENE TIME in bars (Scene bars, 103: 2 = 4 bars), landing on a bar line: a scene change lasts the rest of this bar
# and three more, 3 .. 4 bars at 100 BPM (7.2 .. 9.6 s)
expect par103 2
tapkey w0
wait 100
expect morphms >7100
expect morphms <9700
