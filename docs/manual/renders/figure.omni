# A recipe's render (tools/make_manual.py --renders), headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
tapkey w3
tap PLAY
wait 3000
wav figure.wav
# @ P4 Dreamhouse as it starts: a low A and its seventh harmonic
wait 1500
# @ drone II brighter and forward: its wave to a saw (Osc, KNOB 3), its filter opened, drone I a little back (Drones)
tap EDIT
turn K3 67 20
tap HOME
tap HOME
turn K4 25 40
turn K1 -15 40
wait 800
tap LFO
tap OCT+
tap OCT+
wait 1000
shot figure-0.png
# @ drone II's pitch send up: the high voice steps round a figure of four notes
turn K3 40 60
wait 4500
# @ the LFO's rate up (SELECT): the figure quickens
turn SELECT 55 60
wait 4500
shot figure-1.png
tap SEQ
tap SEQ
# @ Wander up (Pitch moves): every so often the whole figure moves to a new note
turn K3 40 60
wait 4500
shot figure-2.png
wavstop
