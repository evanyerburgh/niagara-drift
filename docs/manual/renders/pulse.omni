# A recipe's render (tools/make_manual.py --renders), headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
tapkey w2
tap PLAY
wait 3000
wav pulse.wav
# @ P3 Vespers as it starts: two voices singing "ah"
wait 3000
tap HOME
# @ drone I's pitch turned down, a note a click: it sinks, then starts to flutter
turn K1 -42 140
wait 1500
shot pulse-0.png
# @ under 20 Hz it's a pulse: each cycle a click, under drone II's "ah"
wait 5000
tap FX
# @ more echoes: the clicks ping through the delay
turn K1 25 60
turn K2 35 60
wait 7000
shot pulse-1.png
wavstop
