# A recipe's render (tools/make_manual.py --renders): from P14, headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
press SEL
tapkey w15
release SEL
tapkey w5
tap PLAY
wait 3000
wav ticks.wav
# @ P14 Tape as it starts: worn, a hum under it
wait 1500
tap HOME
# @ drone I turned down to its lowest notes, A0: a low buzz
turn K1 -29 60
wait 300
tap EDIT
tap EDIT
tapkey b1
tapkey b1
tapkey b1
tapkey b1
tapkey b1
# @ the sub at -4 oct, Osc/Sb all the way to it: the buzz breaks into ticks, about 3 a second
turn K1 85 15
wait 300
shot ticks-0.png
wait 8000
# @ Drive up: each tick gets a harder edge
turn K2 30 40
wait 5000
shot ticks-1.png
wavstop
