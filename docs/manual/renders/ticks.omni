# A recipe's render (tools/make_manual.py --renders): from P14, headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
press SEL
tapkey w15
release SEL
tapkey w5
tap PLAY
wait 1500
wav ticks.wav
# @ P14 Tape as it starts: worn, a hum under it
wait 1000
tap EDIT
tap EDIT
tapkey b1
tapkey b1
tapkey b1
tapkey b1
tapkey b1
# @ Drone I's sub at -4 oct, Osc/Sb all the way to it: a fast flutter, about 18 a second
turn K1 85 15
wait 1500
# @ Drive up: each tick gets a harder edge
turn K2 30 30
shot ticks-0.png
wait 1000
tap HOME
tap HOME
# @ Drone I's pitch turned down quickly, past A0 to 22 Hz: the flutter slows into clicks
turn K1 -33 60
shot ticks-1.png
# @ Held at 22 Hz: clicks, about 3 a second
wait 12000
wavstop
