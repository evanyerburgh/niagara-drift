# A recipe's render (tools/make_manual.py --renders): from P10, headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
press SEL
tapkey w15
release SEL
tapkey w1
tap PLAY
wait 3000
tap ARP
expect view 12
clock 80
wait 3000
turn K1 40 80
wait 2000
wav p-clock.wav
# @ P10 Cistern; a MIDI clock at 80 BPM, the Swell's Division at 1/4: a breath a beat
wait 5000
shot p-clock-0.png
# @ The clock at 140 BPM: the Swell follows, faster
clock 140
wait 6000
shot p-clock-1.png
wavstop
