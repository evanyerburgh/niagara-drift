# A recipe's render (tools/make_manual.py --renders), headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
tapkey w1
tap PLAY
wait 3000
wav tangle.wav
# @ P2 Embers as it starts: triangles blooming toward saws
wait 3000
# @ key 11 twice: cross-FM at the amount already set: the drones roughen
tapkey b10
tapkey b10
wait 4000
tap LFO
tap LFO
wait 400
shot tangle-0.png
# @ X-mod up: they tangle into one restless, metallic sound
turn K4 45 150
wait 7000
shot tangle-1.png
# @ X-mod back down: they come apart
turn K4 -60 80
wait 4000
wavstop
