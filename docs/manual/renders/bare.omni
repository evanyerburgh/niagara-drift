# A recipe's render (tools/make_manual.py --renders): from P16, headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
press SEL
tapkey w15
release SEL
tapkey w7
tap PLAY
wait 3000
wav bare.wav
# @ P16 Bare: one plain saw, drone I
wait 3000
# @ drone I's cutoff down (Drones, KNOB 2): the saw darkens
turn K2 -15 120
wait 2000
# @ SEL + PLAY: drone II comes in, a fifth above
press SEL
tap PLAY
release SEL
wait 4000
shot bare-0.png
tap HOME
# @ drone II tuned (Pitch, KNOB 3): a minor sixth, then back to the fifth
turn K3 1 300
wait 2500
turn K3 -1 300
wait 1500
tap EDIT
tap EDIT
# @ the sub blended in (Sub · Drive, KNOB 1)
turn K1 30 60
wait 3000
tap LFO
# @ a cutoff send (LFO sends, KNOB 2), then Movement up from 0%: the filter starts to breathe
turn K2 40 50
turn ALGO 40 50
wait 6000
shot bare-1.png
tap FX
# @ echoes and reverb (Space, KNOB 2 and 4)
turn K2 30 50
turn K4 30 50
wait 6000
wavstop
