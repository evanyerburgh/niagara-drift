# A recipe's render (tools/make_manual.py --renders): from P8, headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
set 51 37
tapkey w7
tap PLAY
wait 3000
expect view 0
wav p-retune.wav
# @ P8 Sibyl; Fade at 3 s
wait 1500
# @ SEL + PLAY: drone II fades out
press SEL
tap PLAY
release SEL
wait 3500
# @ Drone II retuned in the silence (Pitch, KNOB 3)
tap HOME
expect view 1
turn K3 -8 150
wait 800
shot p-retune-0.png
# @ SEL + PLAY: back in on the new chord
press SEL
tap PLAY
release SEL
wait 4500
shot p-retune-1.png
wavstop
