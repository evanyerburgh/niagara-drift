# A recipe's render (tools/make_manual.py --renders): from P1, headphones, Pitch lock off, Scene time about 2 s.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 27
tapkey w0
tap PLAY
wait 2500
wav s-back.wav
# @ P1 Niagara as it starts
wait 1500
# @ P5 Abyss tapped: it glides over
tapkey w4
wait 4000
shot s-back-0.png
# @ SEL + SAVE: back to the sound before, Niagara
press SEL
tap SAVE
release SEL
wait 4000
shot s-back-1.png
# @ SEL + SAVE again: forward to Abyss
press SEL
tap SAVE
release SEL
wait 4000
wavstop
