# A recipe's render (tools/make_manual.py --renders): from P7, headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
tapkey w6
tap PLAY
wait 3000
wav chase.wav
# @ P7 Sonar as it starts as it starts
wait 1500
tap LFO
tap LFO
# @ Speed mod up (Mods): the LFO speeds up and slows down on its own wave, the sweep rushing and dragging
turn K1 60 60
wait 4500
shot chase-0.png
# @ Source to both LFOs: the push and pull gets lopsided
turn K2 1 60
wait 4500
shot chase-1.png
wavstop
