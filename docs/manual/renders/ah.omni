# A recipe's render (tools/make_manual.py --renders): from P1, headphones, Pitch lock off, Scene time 0.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
tapkey w0
tap PLAY
wait 3000
wav ah.wav
# @ P1 Niagara as it starts as it starts
wait 3000
# @ the filter keys to band-pass: the drones thin to a nasal "ah"
tapkey b2
tapkey b7
wait 3000
tap LFO
# @ on the LFO pages, keys 2 and 7 send the pitch LFOs to X-Wave instead
tapkey b1
tapkey b6
# @ the sends up: each wave turns slowly, the vowel opening and closing
turn K1 40 80
turn K3 -40 80
wait 9000
shot ah-0.png
tap HOME
wait 400
shot ah-1.png
wait 3000
wavstop
