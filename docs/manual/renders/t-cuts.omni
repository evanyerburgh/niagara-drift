# A recipe's render (tools/make_manual.py --renders): from P1, headphones, Pitch lock off.
# "# @" marks the listening times (tools/make_manual.py --times).
notips
phones 1
set 74 0
set 71 0
tapkey w0
tap PLAY
wait 2500
tap GLO
expect view 10
wav t-cuts.wav
# @ P1 Niagara; Scene time at its fastest (Setup 1, KNOB 3 all the way left)
wait 1500
shot t-cuts-0.png
# @ P5 Abyss tapped: a cut
tapkey w4
wait 2500
# @ P1 tapped: a cut back
tapkey w0
wait 2500
# @ Scene time turned to 8 s; P5 tapped: a slow glide, the filters and pitches moving across
set 71 40
wait 300
shot t-cuts-1.png
tapkey w4
wait 9000
wavstop
